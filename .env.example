# Public Supabase values. The publishable key is safe for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Libre OAuth apps, one per launch country.
MELI_AR_CLIENT_ID=
MELI_AR_CLIENT_SECRET=
MELI_CL_CLIENT_ID=
MELI_CL_CLIENT_SECRET=
MELI_OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# At least 32 random characters. Signs short-lived commercial verification proofs.
APP_SIGNING_SECRET=

# Optional until WhatsApp OTP is enabled in Supabase/Twilio Verify.
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false
