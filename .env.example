# Public Supabase values. The publishable key is safe for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared conventional Mercado Libre application for all launch countries.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_OAUTH_REDIRECT_BASE_URL=http://localhost:3000
MELI_USE_PKCE=false

# At least 32 random characters. Signs short-lived commercial verification proofs.
APP_SIGNING_SECRET=

# Enable after configuring Resend SMTP and the email OTP template in Supabase Auth.
NEXT_PUBLIC_ENABLE_EMAIL_AUTH=false
